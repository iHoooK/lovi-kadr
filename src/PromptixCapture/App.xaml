<Application x:Class="PromptixCapture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- The application uses a light surface. Keep all readable text dark so
             code-created controls remain legible even without a custom template. -->
        <Color x:Key="Graphite900">#F7F9FC</Color>
        <Color x:Key="Graphite800">#FFFFFF</Color>
        <Color x:Key="Graphite700">#202936</Color>
        <Color x:Key="Graphite600">#344154</Color>
        <Color x:Key="TextPrimary">#182230</Color>
        <Color x:Key="TextSecondary">#52667F</Color>
        <Color x:Key="ButtonText">#F4F7FB</Color>
        <Color x:Key="Cyan">#35D0FF</Color>
        <Color x:Key="Gold">#F0A43A</Color>
        <Color x:Key="Success">#54D68C</Color>
        <Color x:Key="Danger">#FF647C</Color>

        <SolidColorBrush x:Key="Graphite900Brush" Color="{StaticResource Graphite900}" />
        <SolidColorBrush x:Key="Graphite800Brush" Color="{StaticResource Graphite800}" />
        <SolidColorBrush x:Key="Graphite700Brush" Color="{StaticResource Graphite700}" />
        <SolidColorBrush x:Key="Graphite600Brush" Color="{StaticResource Graphite600}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondary}" />
        <SolidColorBrush x:Key="ButtonTextBrush" Color="{StaticResource ButtonText}" />
        <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource Cyan}" />
        <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource Graphite900Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ButtonTextBrush}" />
            <Setter Property="Background" Value="{StaticResource Graphite700Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Graphite600Brush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{StaticResource CyanBrush}" />
                                <Setter TargetName="Border" Property="Background" Value="#263747" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CyanBrush}" />
            <Setter Property="Foreground" Value="#071118" />
            <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Graphite800Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource Graphite600Brush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Graphite800Brush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Padding" Value="8,5" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Application.Resources>
</Application>
